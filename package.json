{
  "name": "chewmash",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "wxt build",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "preview:web": "vite preview --config apps/web/vite.config.ts",
    "mobile:add:ios": "npm run build:web && cd apps/mobile && npx cap add ios",
    "mobile:sync": "npm run build:web && cd apps/mobile && npx cap sync ios",
    "mobile:open:ios": "cd apps/mobile && npx cap open ios",
    "mobile:doctor": "cd apps/mobile && npx cap doctor",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "test": "vitest run",
    "check:manifest": "node scripts/check-manifest.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
