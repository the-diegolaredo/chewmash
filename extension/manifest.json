{
  "manifest_version": 3,
  "name": "ChewMash GET Sync",
  "version": "0.2.0",
  "description": "Privately sync Cal Poly GET dining transactions into ChewMash without collecting Cal Poly credentials.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://get.cbord.com/calpoly/*",
    "https://the-diegolaredo.github.io/chewmash/*"
  ],
  "action": {
    "default_title": "ChewMash GET Sync",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://get.cbord.com/calpoly/*"],
      "js": ["get-content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://the-diegolaredo.github.io/chewmash/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
